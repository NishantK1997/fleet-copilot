# Local defaults are safe for development. Do not commit real secrets in .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/fleet_copilot.db

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

LLM_PROVIDER=huggingface
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_API_KEY=replace-with-your-huggingface-key

API_HOST=0.0.0.0
API_PORT=8000


